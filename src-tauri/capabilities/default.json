{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "sql:allow-execute",
    "sql:allow-load",
    "sql:allow-select",
    "sql:default",
    "sql:allow-close",
    "dialog:allow-save",
    "dialog:allow-confirm",
    "dialog:allow-message",
    "fs:allow-write-text-file",
    {
      "identifier": "fs:default",
      "allow": [{ "path": "**" }] 
    }
  ]
}